---
// Design system v3 landing page. One persistent 3D deck (ScrollWorld)
// transforms behind five chapters that walk the core loop; the quick start
// (name -> table, no account) sits in the hero and again at the end, so the
// first real action needs one field. prerender = false: nav and the quick
// start branch on sign-in state server-side.
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollWorld from "@/components/home/ScrollWorld.astro";
import { QuickStart } from "@/components/home/quick-start";
import { createSupabaseServerClient } from "@/lib/supabase/server";

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();
const isSignedIn = Boolean(user);
const displayName =
  (user?.user_metadata?.display_name as string | undefined) ?? user?.email ?? "there";

const year = new Date().getFullYear();

// Chapter 0 is the hero; 1-4 walk the loop. `label` feeds the chapter index.
const steps = [
  { label: "Your table", title: "Start a table. Friends join with a four-letter code.", body: "No app to download and no account to make. Share the code or the link and everyone is in." },
  { label: "Swipe", title: "Everyone swipes the same deck.", body: "You see who has voted on a card, never what they picked, so nobody bandwagons." },
  { label: "Match", title: "The moment all of you say yes, that's dinner.", body: "Food Swipe rolls the match straight into real places nearby, best rated first." },
  { label: "Order", title: "Pick dishes together, then order for real.", body: "Dishes lock in when the whole table agrees. Call the restaurant or open it on Zomato or Swiggy." },
];
const words = (s: string) => s.split(" ");
---

<BaseLayout title="Food Swipe" description="Stop arguing. Start eating. Swipe together, decide together.">
  <ScrollWorld />

  <header class="fixed inset-x-0 top-0 z-20">
    <div class="fs-glass fs-glass-border mx-3 mt-3 flex items-center justify-between rounded-[var(--fs-r-pill)] py-2 pl-2 pr-2 sm:mx-6 lg:mx-auto lg:max-w-[1200px]">
      <a href="/" class="group flex items-center gap-2">
        <div class="rounded-[var(--fs-r-sm)] bg-[var(--fs-terracotta)] p-2 text-[var(--fs-on-ink)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
            <path d="M7 2v20" />
            <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
          </svg>
        </div>
        <span class="font-display text-xl font-bold tracking-[-.02em] text-[var(--fs-on-ink)]">Food Swipe</span>
      </a>
      <nav class="flex items-center gap-2">
        {isSignedIn ? (
          <>
            <a
              href="/logout"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] px-4 font-body text-sm font-medium text-[var(--fs-on-dark-4)] transition-colors hover:text-[var(--fs-on-ink)]"
            >
              Log out
            </a>
            <a
              href="/rooms"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] bg-[var(--fs-terracotta-text)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-[var(--fs-terracotta-hover)]"
            >
              Open App
            </a>
          </>
        ) : (
          <a
            href="/login"
            class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] border border-[var(--fs-glass-line)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-white/10"
          >
            Log in
          </a>
        )}
      </nav>
    </div>
  </header>

  <!-- Fixed chapter index (award-site pattern): number, label, progress. Driven by ScrollWorld. -->
  <div class="fs-glass pointer-events-none fixed bottom-5 left-8 z-20 hidden items-center gap-3 rounded-[var(--fs-r-pill)] px-4 py-2 font-body text-xs text-[var(--fs-text-4)] lg:flex" aria-hidden="true">
    <span class="tabular-nums"><span id="hud-num" class="font-semibold text-[var(--fs-on-ink)]">01</span> / 05</span>
    <span class="relative h-px w-24 overflow-hidden bg-[var(--fs-line-strong)]">
      <span id="hud-bar" class="absolute inset-0 origin-left scale-x-0 bg-[var(--fs-gold)]"></span>
    </span>
    <span id="hud-label">Start</span>
  </div>

  <main id="world" class="relative z-10">
    <section data-label="Start" class="chapter is-active flex min-h-screen items-end px-4 pb-16 pt-24 sm:px-6 lg:items-center lg:px-8 lg:pb-24">
      <div class="copy fs-glass fs-glass-border grid w-full max-w-[38rem] gap-6 rounded-[var(--fs-r-2xl)] p-6 sm:p-8 lg:ml-[4vw]">
        <h1 class="font-display text-[clamp(2.8rem,5.6vw,4.9rem)] font-bold leading-[0.96] tracking-[-.04em] text-[var(--fs-on-ink)]">
          Stop arguing.<br /><span class="text-[var(--fs-terracotta)]">Start eating.</span>
        </h1>
        <p class="max-w-[28rem] font-body text-lg text-[var(--fs-text-3)]">
          Your table swipes the same cuisines. When everyone says yes, that's dinner.
        </p>
        {isSignedIn && (
          <p class="font-body text-sm text-[var(--fs-on-dark-4)]">
            Signed in as <span class="font-semibold text-[var(--fs-on-ink)]">{displayName}</span>
          </p>
        )}
        <QuickStart client:load signedIn={isSignedIn} />
      </div>
    </section>

    {steps.map((s) => (
      <section data-label={s.label} class="chapter flex min-h-[120vh] items-end px-4 pb-16 pt-24 sm:px-6 lg:items-center lg:px-8 lg:pb-24">
        <div class="copy fs-glass fs-glass-border grid w-full max-w-[32rem] gap-4 rounded-[var(--fs-r-2xl)] p-6 sm:p-8 lg:ml-[4vw]">
          <h2 class="fill-words font-display text-[clamp(2.1rem,4.4vw,3.5rem)] font-bold leading-[1] tracking-[-.035em] text-[var(--fs-on-ink)]">
            {words(s.title).map((w) => <><span class="w">{w}</span> </>)}
          </h2>
          <p class="max-w-[28rem] font-body text-lg text-[var(--fs-text-3)]">{s.body}</p>
        </div>
      </section>
    ))}
  </main>

  <section class="relative z-10 flex min-h-[80vh] items-center px-4 py-24 sm:px-6 lg:px-8">
    <div class="fs-glass fs-glass-border grid w-full max-w-[34rem] gap-6 rounded-[var(--fs-r-2xl)] p-6 sm:p-8 lg:ml-[4vw]">
      <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.98] tracking-[-.04em] text-[var(--fs-on-ink)]">
        Your table is one name away.
      </h2>
      <QuickStart client:visible signedIn={isSignedIn} />
    </div>
  </section>

  <footer class="relative z-10 border-t border-[var(--fs-line)] bg-[var(--fs-cream)] py-6 text-center font-body text-sm text-[var(--fs-text-5)]">
    <p>&copy; {year} Food Swipe. All rights reserved.</p>
  </footer>
</BaseLayout>

<style>
  /* Copy dims between chapters and settles on the active one (class set by ScrollWorld). */
  .copy {
    opacity: 0.35;
    transform: translateY(10px);
    transition: opacity 0.5s var(--fs-ease-out), transform 0.5s var(--fs-ease-out);
  }
  .chapter.is-active .copy {
    opacity: 1;
    transform: none;
  }
  /* Word-by-word headline fill; .lit toggled by ScrollWorld as the chapter scrolls in. */
  .fill-words .w {
    color: var(--fs-text-6);
    transition: color 0.35s var(--fs-ease-out);
  }
  .fill-words .w.lit {
    color: inherit;
  }
</style>
