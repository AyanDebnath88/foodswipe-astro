---
// Design system v3 landing page: a 3D scroll story (ScrollWorld) behind five
// chapters that walk the core loop -- start a table, swipe, match, order.
// Deviations kept from earlier passes:
//   - CTAs point to /signup (signed out) or /rooms (signed in).
//   - prerender = false: nav and CTAs branch on sign-in state server-side.
// The v2 crossfading hero photography is replaced by the world's floating
// photo cards; the header is fixed transparent chrome over the canvas.
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollWorld from "@/components/home/ScrollWorld.astro";
import { CtaArrow } from "@/components/ui/button";
import { createSupabaseServerClient } from "@/lib/supabase/server";

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();
const isSignedIn = Boolean(user);
const displayName =
  (user?.user_metadata?.display_name as string | undefined) ?? user?.email ?? "there";

const ctaHref = isSignedIn ? "/rooms" : "/signup";
const year = new Date().getFullYear();

const steps = [
  {
    tag: "Step 1 of 4",
    title: "Start a table in one tap.",
    muted: "",
    body: "You get a four-letter code and a link. Friends join with it and you all swipe the same deck.",
  },
  {
    tag: "Step 2 of 4",
    title: "Swipe together.",
    muted: "Feel the table.",
    body: "Everyone swipes the same cuisines. You see who has voted on a card, never what they picked, so nobody bandwagons.",
  },
  {
    tag: "Step 3 of 4",
    title: "Everyone said yes.",
    muted: "That's dinner.",
    body: "The moment the whole table agrees, Food Swipe shows real places nearby, best rated first.",
  },
];
---

<BaseLayout title="Food Swipe" description="Stop arguing. Start eating. Swipe together, decide together.">
  <ScrollWorld />

  <header class="fixed inset-x-0 top-0 z-20">
    <div class="container mx-auto flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="group flex items-center gap-2">
        <div class="rounded-[var(--fs-r-sm)] bg-[var(--fs-terracotta)] p-2 text-[var(--fs-on-ink)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
            <path d="M7 2v20" />
            <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
          </svg>
        </div>
        <span class="font-display text-xl font-bold tracking-[-.02em] text-[var(--fs-on-ink)]">Food Swipe</span>
      </a>
      <nav class="flex items-center gap-2">
        {isSignedIn ? (
          <>
            <a
              href="/logout"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] px-4 font-body text-sm font-medium text-[var(--fs-on-dark-4)] transition-colors hover:text-[var(--fs-on-ink)]"
            >
              Log out
            </a>
            <a
              href="/rooms"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] bg-[var(--fs-terracotta-text)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-[var(--fs-terracotta-hover)]"
            >
              Open App
            </a>
          </>
        ) : (
          <>
            <a
              href="/login"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] border-[1.5px] border-[var(--fs-glass-line)] bg-[var(--fs-ink)]/60 px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] backdrop-blur-[6px] transition-colors hover:bg-white/5"
            >
              Sign In
            </a>
            <a
              href="/signup"
              class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] bg-[var(--fs-terracotta-text)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-[var(--fs-terracotta-hover)]"
            >
              Sign Up Free
            </a>
          </>
        )}
      </nav>
    </div>
  </header>

  <main id="world" class="relative z-10">
    <section class="chapter is-active flex min-h-screen items-end px-4 py-24 sm:px-6 lg:items-center lg:px-8">
      <div class="copy grid max-w-[31rem] gap-5 lg:ml-[6vw]">
        <h1 class="font-display text-[clamp(3rem,7.4vw,5.6rem)] font-bold leading-[0.98] tracking-[-.035em] text-[var(--fs-on-ink)]">
          Stop arguing. <span class="text-[var(--fs-text-5)]">Start eating.</span>
        </h1>
        <p class="max-w-[29rem] font-body text-lg text-[var(--fs-text-3)]">
          Your whole table swipes on the same cuisines, and Food Swipe finds the one thing everyone actually wants.
        </p>
        {isSignedIn && (
          <p class="font-body text-sm text-[var(--fs-on-dark-4)]">
            Signed in as <span class="font-semibold text-[var(--fs-on-ink)]">{displayName}</span>
          </p>
        )}
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={ctaHref}
            class="group inline-flex h-[var(--fs-cta-h)] items-center justify-between gap-3 rounded-[var(--fs-r-pill)] bg-[var(--fs-on-ink)] pl-[22px] pr-1.5 font-body text-base font-semibold text-[var(--fs-ink)] shadow-[var(--fs-e-float)] transition-shadow hover:shadow-[var(--fs-e-primary)]"
          >
            <span>{isSignedIn ? "Start a table" : "Get started"}</span>
            <CtaArrow />
          </a>
          <span class="font-body text-sm text-[var(--fs-text-5)]">or scroll</span>
        </div>
      </div>
    </section>

    {steps.map((s, i) => (
      <section class="chapter flex min-h-[115vh] items-end px-4 py-24 sm:px-6 lg:items-center lg:px-8">
        <div class={`copy grid max-w-[31rem] gap-4 ${i % 2 === 0 ? "lg:ml-auto lg:mr-[6vw]" : "lg:ml-[6vw]"}`}>
          <span class="inline-flex items-center gap-2 font-body text-[13px] font-semibold text-[var(--fs-text-3)]">
            <i class="h-[7px] w-[7px] rounded-full bg-[var(--fs-terracotta)]"></i>{s.tag}
          </span>
          <h2 class="font-display text-[clamp(2.2rem,4.6vw,3.6rem)] font-bold leading-[0.98] tracking-[-.035em] text-[var(--fs-on-ink)]">
            {s.title} {s.muted && <span class="text-[var(--fs-text-5)]">{s.muted}</span>}
          </h2>
          <p class="max-w-[29rem] font-body text-lg text-[var(--fs-text-3)]">{s.body}</p>
        </div>
      </section>
    ))}

    <section class="chapter flex min-h-[115vh] items-end px-4 py-24 sm:px-6 lg:items-center lg:px-8">
      <div class="copy grid max-w-[31rem] gap-4 lg:ml-[6vw]">
        <span class="inline-flex items-center gap-2 font-body text-[13px] font-semibold text-[var(--fs-text-3)]">
          <i class="h-[7px] w-[7px] rounded-full bg-[var(--fs-terracotta)]"></i>Step 4 of 4
        </span>
        <h2 class="font-display text-[clamp(2.2rem,4.6vw,3.6rem)] font-bold leading-[0.98] tracking-[-.035em] text-[var(--fs-on-ink)]">
          Pick dishes. Order for real.
        </h2>
        <p class="max-w-[29rem] font-body text-lg text-[var(--fs-text-3)]">
          Tap what the table wants and watch dishes lock in live, then call the restaurant or open it on Zomato or Swiggy.
        </p>
        <div>
          <a
            href={ctaHref}
            class="group inline-flex h-[var(--fs-cta-h)] items-center justify-between gap-3 rounded-[var(--fs-r-pill)] bg-[var(--fs-on-ink)] pl-[22px] pr-1.5 font-body text-base font-semibold text-[var(--fs-ink)] shadow-[var(--fs-e-float)] transition-shadow hover:shadow-[var(--fs-e-primary)]"
          >
            <span>{isSignedIn ? "Start a table" : "Start swiping free"}</span>
            <CtaArrow />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="relative z-10 border-t border-[var(--fs-line)] bg-[var(--fs-cream)] py-6 text-center font-body text-sm text-[var(--fs-text-5)]">
    <p>&copy; {year} Food Swipe. All rights reserved.</p>
  </footer>
</BaseLayout>

<style>
  /* Copy dims between chapters and settles on the active one (class set by ScrollWorld's script). */
  .copy {
    opacity: 0.35;
    transform: translateY(10px);
    transition: opacity 0.5s var(--fs-ease-out), transform 0.5s var(--fs-ease-out);
  }
  .copy > * {
    text-shadow: 0 2px 24px rgba(17, 17, 17, 0.9);
  }
  .copy a {
    text-shadow: none;
  }
  .chapter.is-active .copy {
    opacity: 1;
    transform: none;
  }
</style>
