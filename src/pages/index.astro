---
// Design system v2 landing page. Deviations from the ported reference kept
// from earlier passes:
//   - The Get Started CTA points to /signup (see original file history).
//   - prerender = false: nav below branches on sign-in state server-side.
// v2 change: the v1 CSS-only "floating glass panels" wash is gone -- v2's
// home hero is full-bleed photography with a directional scrim
// (design-language-v2.md's desktop-hero note), not a glassmorphic abstract
// background. Header is transparent chrome sitting directly on the photo's
// scrim rather than its own ink bar, since the scrim already provides the
// dark ground text needs.
import BaseLayout from "../layouts/BaseLayout.astro";
import { CtaArrow } from "@/components/ui/button";
import { createSupabaseServerClient } from "@/lib/supabase/server";

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();
const isSignedIn = Boolean(user);
const displayName =
  (user?.user_metadata?.display_name as string | undefined) ?? user?.email ?? "there";

const year = new Date().getFullYear();
---

<BaseLayout title="Food Swipe" description="Stop arguing. Start eating. Swipe together, decide together.">
  <div class="relative h-screen w-full overflow-hidden bg-[var(--fs-ink)]">
    <!-- Full-bleed hero photography (v2: replaces the v1 glass-panel wash). -->
    <img
      src="/images/cuisines/italian.jpg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="pointer-events-none absolute inset-0"
      style={{ background: "var(--fs-scrim-vertical)" }}
    />
    <div
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style={{ background: "var(--fs-scrim-hero-d)" }}
    />

    <div class="relative z-10 flex h-full flex-col">
      <header class="container mx-auto flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="group flex items-center gap-2">
          <div class="rounded-[var(--fs-r-sm)] bg-[var(--fs-terracotta)] p-2 text-[var(--fs-on-ink)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
              <path d="M7 2v20" />
              <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
            </svg>
          </div>
          <span class="font-display text-xl font-extrabold uppercase tracking-[-.02em] text-[var(--fs-on-ink)]">Food Swipe</span>
        </a>
        <nav class="flex items-center gap-2">
          {isSignedIn ? (
            <>
              <a
                href="/logout"
                class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] px-4 font-body text-sm font-medium text-[var(--fs-on-dark-4)] transition-colors hover:text-[var(--fs-on-ink)]"
              >
                Log out
              </a>
              <a
                href="/rooms"
                class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] bg-[var(--fs-terracotta-text)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-[var(--fs-terracotta-hover)]"
              >
                Open App
              </a>
            </>
          ) : (
            <>
              <a
                href="/login"
                class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] border-[1.5px] border-[var(--fs-glass-line)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-white/5"
              >
                Sign In
              </a>
              <a
                href="/signup"
                class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-[var(--fs-r-pill)] bg-[var(--fs-terracotta-text)] px-4 font-body text-sm font-medium text-[var(--fs-on-ink)] transition-colors hover:bg-[var(--fs-terracotta-hover)]"
              >
                Sign Up Free
              </a>
            </>
          )}
        </nav>
      </header>

      <main class="flex flex-1 flex-col items-center justify-center px-4 text-center">
        <h1 class="font-display text-5xl font-extrabold uppercase leading-[0.9] tracking-[-.03em] text-[var(--fs-on-ink)] md:text-[length:var(--fs-t-hero-d)]">
          Stop arguing.<br />Start eating.
        </h1>
        <p class="mt-6 max-w-2xl font-body text-lg text-[var(--fs-on-dark-2)] md:text-xl">
          Tired of the endless 'what do you want to eat?' debate? Food Swipe lets you and your friends swipe on cuisines together. When you all swipe right, it's a match!
        </p>
        {isSignedIn && (
          <p class="mt-6 font-body text-sm text-[var(--fs-on-dark-4)]">
            Signed in as <span class="font-semibold text-[var(--fs-on-ink)]">{displayName}</span>
          </p>
        )}
        <div class="mt-8">
          <a
            href={isSignedIn ? "/rooms" : "/signup"}
            class="group inline-flex h-[var(--fs-cta-h)] items-center justify-between gap-3 rounded-[var(--fs-r-pill)] bg-[var(--fs-on-ink)] pl-[22px] pr-1.5 font-body text-base font-semibold text-[var(--fs-text)] shadow-[var(--fs-e-float)] transition-shadow hover:shadow-[var(--fs-e-primary)]"
          >
            <span>{isSignedIn ? "Start a Swipe Room" : "Get Started"}</span>
            <CtaArrow />
          </a>
        </div>
      </main>

      <footer class="py-6 text-center font-body text-sm text-[var(--fs-on-dark-4)]">
        <p>&copy; {year} Food Swipe. All rights reserved.</p>
      </footer>
    </div>
  </div>
</BaseLayout>
