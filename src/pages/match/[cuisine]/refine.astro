---
// The refine layer (0017_indian_subcuisines.sql): reached only after a room
// matches on a cuisine with real internal breadth (today: 'indian'). Route
// is generic (/match/[cuisine]/refine, not /match/indian/refine hardcoded)
// so a future cuisine with the same kind of breadth can reuse this page --
// SubcuisineSwipeArea itself already takes cuisineId as a prop and queries
// cuisine_subcategories by it, so no Indian-specific logic lives here.
//
// Same prerender=false requirement as swipe.astro/match/[cuisine].astro --
// reads Astro.url.searchParams at request time.
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import AppHeader from "../../../components/shared/AppHeader.astro";
import { SubcuisineSwipeArea } from "../../../components/swipe/subcuisine-swipe-area";
import { Toaster } from "../../../components/ui/toaster";

const { cuisine } = Astro.params;
const roomCode = Astro.url.searchParams.get("room");

if (!cuisine || !roomCode || roomCode.trim().length !== 4) {
  return Astro.redirect("/rooms");
}

const cuisineName = cuisine.charAt(0).toUpperCase() + cuisine.slice(1);
---

<BaseLayout title={`Let's narrow it down · Room ${roomCode}`} description="Pick which style of cuisine your group wants.">
  <div class="min-h-screen bg-background">
    <AppHeader roomCode={roomCode} />
    <div class="flex flex-col items-center w-full pt-10 pb-8">
      <div class="text-center mb-8 px-4">
        <h1 class="text-3xl md:text-4xl font-headline">You all want {cuisineName} -- but what kind?</h1>
        <p class="text-muted-foreground mt-2">
          Swipe right on the styles everyone's up for. First one you all agree on wins.
        </p>
      </div>
      <div class="w-full flex justify-center px-4">
        <SubcuisineSwipeArea cuisineId={cuisine} roomCode={roomCode} client:load />
      </div>
    </div>
  </div>
  <Toaster client:load />
</BaseLayout>
