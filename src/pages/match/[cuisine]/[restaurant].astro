---
// Phase 2, Task 7 UI route. Dynamic route, SSR (same reasoning as
// match/[cuisine].astro).
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import AppHeader from "../../../components/shared/AppHeader.astro";
import { DishSwipeArea } from "../../../components/dishes/dish-swipe-area";
import { Toaster } from "../../../components/ui/toaster";

const { cuisine, restaurant } = Astro.params;
const roomCode = Astro.url.searchParams.get("room");
// Optional -- only present when the room reached this restaurant via a real
// search result (match-reveal.tsx's goToDishes()), which knows the address.
// The "type a restaurant name yourself" path has no address to carry, and
// that's fine: delivery-links.ts's search just falls back to name-only.
const restaurantAddress = Astro.url.searchParams.get("address");

if (!cuisine || !restaurant || !roomCode || roomCode.trim().length !== 4) {
  return Astro.redirect("/rooms");
}

const restaurantName = decodeURIComponent(restaurant);
---

<BaseLayout title={`Dishes at ${restaurantName} · Food Swipe`} description="Swipe on dishes together as a group.">
  <AppHeader roomCode={roomCode} />
  <div class="flex flex-col items-center w-full min-h-screen pt-10 pb-[140px] lg:pb-8 bg-background">
    <div class="text-center mb-8 px-4">
      <div class="inline-block bg-primary/20 p-4 rounded-full mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-primary" aria-hidden="true">
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
          <path d="M7 2v20" />
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
        </svg>
      </div>
      <h1 class="text-3xl md:text-4xl font-headline">What to eat at {restaurantName}?</h1>
      <p class="text-muted-foreground mt-2">
        Swipe on dishes together -- as soon as everyone agrees, it's decided for the whole table.
      </p>
    </div>
    <div class="w-full flex justify-center px-4">
      <DishSwipeArea
        cuisineId={cuisine}
        restaurantName={restaurantName}
        restaurantAddress={restaurantAddress ?? undefined}
        roomCode={roomCode}
        client:load
      />
    </div>
  </div>
  <Toaster client:load />
</BaseLayout>
