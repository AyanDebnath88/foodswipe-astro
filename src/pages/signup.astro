---
// Ported from the reference Next.js project's src/app/(auth)/layout.tsx +
// src/app/(auth)/signup/page.tsx, combined into one page since Astro has no
// route-group layout for just this page pair.
//
// The reference page wraps SignupForm in shadcn's <Card>. Card isn't in the
// Task 3 port list (only button/input/label/form/separator/toast/toaster +
// utils + logo were ported), so the card chrome is reproduced here with the
// same Tailwind classes Card/CardHeader/CardTitle/CardDescription/CardContent
// would generate, rather than pulling in an unlisted component.
// Signed-in guard. /login has had one since Task 6; this page did not, so an
// already-authenticated user could land on "Create an Account" and be invited
// to sign up over the top of a live session -- self-contradictory, and the
// only page pair in the app that disagreed with itself about auth state.
// Same shape as login.astro, including the ?redirect= passthrough and the
// defensive try/catch around a Supabase call that can fail on the network
// rather than cleanly returning { user: null }.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { Logo } from "../components/shared/logo";
import { SignupForm } from "../components/auth/signup-form";
import { Toaster } from "../components/ui/toaster";
import { createSupabaseServerClient } from "../lib/supabase/server";

let isAuthenticated = false;
try {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const {
    data: { user },
  } = await supabase.auth.getUser();
  isAuthenticated = user !== null;
} catch (error) {
  console.error("Failed to check auth state on /signup:", error);
}

const requested = Astro.url.searchParams.get("redirect");
const safeRedirect =
  requested && requested.startsWith("/") && !requested.startsWith("//") && !requested.includes("\\")
    ? requested
    : null;

if (isAuthenticated) {
  return Astro.redirect(safeRedirect ?? "/rooms");
}
---

<BaseLayout title="Sign Up · Food Swipe" description="Create your Food Swipe account.">
  <div class="flex flex-col items-center justify-center min-h-screen bg-background p-4">
    <div class="mb-8">
      <Logo />
    </div>
    <div class="w-full max-w-sm rounded-lg border bg-card text-card-foreground shadow-lg">
      <div class="flex flex-col space-y-1.5 p-6">
        <h1 class="text-2xl font-headline leading-none tracking-tight">Create an Account</h1>
        <p class="text-sm text-muted-foreground">
          Enter your information to create an account.
        </p>
      </div>
      <div class="p-6 pt-0">
        <SignupForm client:load />
        <div class="mt-4 text-center text-sm">
          Already have an account?
          <a href="/login" class="underline">Log in</a>
        </div>
      </div>
    </div>
  </div>
  <Toaster client:load />
</BaseLayout>
