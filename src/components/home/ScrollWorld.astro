---
// Home-page 3D scroll world (design v3 "Charcoal & Tomato").
// One persistent object -- a deck of real cuisine photo cards -- that
// transforms as native scroll moves through the `.chapter` sections inside
// `#world` (award-site pattern: one hero object morphing, not a camera
// flying between separate set pieces):
//   0 stacked deck · 1 fanned hand + table code · 2 cards swiped off one by
//   one · 3 Korean is the match, heart · 4 card flips to the order.
// Also drives the DOM: fixed chapter index (#chapter-hud) and the
// word-by-word fill on `.fill-words` headlines.
// No WebGL -> canvas keeps its CSS gradient, copy still reads.
// prefers-reduced-motion -> progress snaps per chapter, nothing idles.
---

<div class="scroll-world-aurora" aria-hidden="true"></div>
<canvas id="scroll-world" aria-hidden="true"></canvas>
<div class="scroll-world-vignette" aria-hidden="true"></div>

<style>
  #scroll-world {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }
  /* Slow tomato/amber aurora behind the transparent canvas: gives the glass panels colour to blur. */
  .scroll-world-aurora {
    position: fixed;
    inset: -20%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(32% 28% at 68% 38%, rgba(255, 75, 43, 0.22), transparent 70%),
      radial-gradient(26% 24% at 30% 70%, rgba(232, 255, 58, 0.07), transparent 70%),
      radial-gradient(40% 36% at 80% 85%, rgba(142, 31, 18, 0.4), transparent 70%),
      var(--fs-cream);
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }
  @keyframes aurora-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-4%, 3%, 0) scale(1.08); }
  }
  .scroll-world-vignette {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.55));
  }
</style>

<script>
  import * as THREE from "three";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const coarse = window.matchMedia("(pointer: coarse)").matches;
  const canvas = document.getElementById("scroll-world") as HTMLCanvasElement;
  const world = document.getElementById("world") as HTMLElement;
  const chapters = Array.from(document.querySelectorAll<HTMLElement>(".chapter"));
  const hudNum = document.getElementById("hud-num");
  const hudLabel = document.getElementById("hud-label");
  const hudBar = document.getElementById("hud-bar");
  const fills = chapters.map((c) => Array.from(c.querySelectorAll<HTMLElement>(".fill-words .w")));
  const N = chapters.length;

  const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const bell = (x: number, c: number, w: number) => Math.max(0, 1 - ((x - c) / w) ** 2);

  // ---------- scroll progress (shared by DOM + WebGL) ----------
  let target = 0;
  let smoothP = 0;
  let worldVisible = true;
  // Scroll position at which each chapter is centred; progress is
  // piecewise-linear between them so a centred chapter is exactly its stop.
  let anchors: number[] = [];
  function measure() {
    anchors = chapters.map((c) => {
      const r = c.getBoundingClientRect();
      return Math.max(0, r.top + window.scrollY + r.height / 2 - window.innerHeight / 2);
    });
  }
  function readProgress() {
    const y = window.scrollY;
    if (y <= anchors[0]) return 0;
    for (let i = 0; i < N - 1; i++) {
      if (y < anchors[i + 1]) return i + (y - anchors[i]) / Math.max(1, anchors[i + 1] - anchors[i]);
    }
    return N - 1;
  }
  function syncDom() {
    const idx = Math.round(target);
    chapters.forEach((c, i) => c.classList.toggle("is-active", i === idx));
    if (hudNum) hudNum.textContent = String(idx + 1).padStart(2, "0");
    if (hudLabel) hudLabel.textContent = chapters[idx].dataset.label ?? "";
    if (hudBar) hudBar.style.transform = `scaleX(${(target / (N - 1)).toFixed(3)})`;
    fills.forEach((words, i) => {
      // headline words light up as the chapter scrolls in; the hero is always lit
      const lit = i === 0 || reduce ? words.length : Math.ceil(clamp((target - (i - 0.55)) / 0.45) * words.length);
      words.forEach((w, k) => w.classList.toggle("lit", k < lit));
    });
  }
  window.addEventListener("scroll", () => { target = readProgress(); syncDom(); }, { passive: true });
  window.addEventListener("resize", () => { measure(); target = readProgress(); syncDom(); });
  measure();
  target = smoothP = readProgress();
  syncDom();

  if ("IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => { worldVisible = e.isIntersecting; }).observe(world);
  }

  function hasGL() {
    try {
      const c = document.createElement("canvas");
      return !!(window.WebGLRenderingContext && (c.getContext("webgl2") || c.getContext("webgl")));
    } catch {
      return false;
    }
  }
  const fontsReady = document.fonts?.ready
    ? Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))])
    : Promise.resolve();
  if (hasGL()) fontsReady.then(buildWorld);

  function buildWorld() {
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, coarse ? 1.5 : 2));
    renderer.setClearColor(0x000000, 0); // aurora shows through
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 50);
    camera.position.set(0, 0, 7.5);

    scene.add(new THREE.AmbientLight(0xffffff, 1.1));
    const key = new THREE.DirectionalLight(0xfff3e6, 3);
    key.position.set(-3, 5, 6);
    scene.add(key);
    const rim = new THREE.PointLight(0xff4b2b, 0, 6, 2);
    scene.add(rim);

    // Everything lives in one group so desktop/phone framing is one offset.
    const rig = new THREE.Group();
    scene.add(rig);

    // Soft tomato glow behind the deck; swells at the match.
    const glowCanvas = document.createElement("canvas");
    glowCanvas.width = glowCanvas.height = 256;
    const gg = glowCanvas.getContext("2d")!;
    const rad = gg.createRadialGradient(128, 128, 0, 128, 128, 128);
    rad.addColorStop(0, "rgba(255,75,43,.9)");
    rad.addColorStop(0.4, "rgba(255,75,43,.25)");
    rad.addColorStop(1, "rgba(255,75,43,0)");
    gg.fillStyle = rad;
    gg.fillRect(0, 0, 256, 256);
    const glowMat = new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(glowCanvas), transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: 0.3 });
    const glow = new THREE.Mesh(new THREE.PlaneGeometry(6, 6), glowMat);
    glow.position.z = -1.2;
    rig.add(glow);

    // ---------- canvas-texture helpers ----------
    type Draw = (g: CanvasRenderingContext2D, w: number, h: number, imgs: (HTMLImageElement | null)[]) => void;
    function rr(g: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      g.beginPath();
      g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r);
      g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r);
      g.arcTo(x, y, x + w, y, r);
      g.closePath();
    }
    function cover(g: CanvasRenderingContext2D, img: HTMLImageElement, x: number, y: number, w: number, h: number) {
      const s = Math.max(w / img.width, h / img.height);
      g.drawImage(img, x + (w - img.width * s) / 2, y + (h - img.height * s) / 2, img.width * s, img.height * s);
    }
    const imgCache = new Map<string, Promise<HTMLImageElement>>();
    function loadImg(src: string) {
      if (!imgCache.has(src)) {
        imgCache.set(src, new Promise((res, rej) => {
          const img = new Image();
          img.decoding = "async";
          img.onload = () => res(img);
          img.onerror = rej;
          img.src = src;
        }));
      }
      return imgCache.get(src)!;
    }
    // Paints a placeholder now, repaints once every listed photo has loaded.
    function makeTex(w: number, h: number, srcs: string[], draw: Draw) {
      const c = document.createElement("canvas");
      c.width = w;
      c.height = h;
      const g = c.getContext("2d")!;
      draw(g, w, h, srcs.map(() => null));
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      t.anisotropy = 4;
      Promise.allSettled(srcs.map(loadImg)).then((rs) => {
        draw(g, w, h, rs.map((r) => (r.status === "fulfilled" ? r.value : null)));
        t.needsUpdate = true;
      });
      return t;
    }
    const FONT = "'Inter Tight', system-ui, sans-serif";
    function badge(g: CanvasRenderingContext2D, x: number, y: number, text: string, bg: string, ink: string, size = 22) {
      g.font = `600 ${size}px ${FONT}`;
      const bw = g.measureText(text).width + size * 1.3;
      g.fillStyle = bg;
      rr(g, x, y, bw, size * 1.8, size * 0.9);
      g.fill();
      g.fillStyle = ink;
      g.fillText(text, x + size * 0.65, y + size * 1.25);
    }

    // Glass finish shared by every card face: diagonal gloss + a bone->tomato rim.
    function glassFinish(g: CanvasRenderingContext2D, w: number, h: number) {
      const gloss = g.createLinearGradient(0, 0, w * 0.75, h * 0.6);
      gloss.addColorStop(0, "rgba(255,255,255,.2)");
      gloss.addColorStop(0.35, "rgba(255,255,255,.05)");
      gloss.addColorStop(0.36, "rgba(255,255,255,0)");
      g.fillStyle = gloss;
      g.fillRect(0, 0, w, h);
      const rim = g.createLinearGradient(0, 0, w, h);
      rim.addColorStop(0, "rgba(255,248,242,.55)");
      rim.addColorStop(0.5, "rgba(255,75,43,.5)");
      rim.addColorStop(1, "rgba(232,255,58,.3)");
      g.strokeStyle = rim;
      g.lineWidth = 4;
      rr(g, 4, 4, w - 8, h - 8, 28);
      g.stroke();
    }

    // ---------- the deck ----------
    const W = 1.5, H = 2.0;
    const DECK: [string, string, string][] = [
      ["italian", "Italian", "Margherita · Carbonara"],
      ["mexican", "Mexican", "Al pastor · Birria"],
      ["thai", "Thai", "Pad thai · Green curry"],
      ["indian-south", "South Indian", "Dosa · Idli · Pongal"],
      ["korean", "Korean", "Bibimbap · Galbi"],
    ];
    const SWIPE_DIR = [-1, 1, -1, -1]; // pass, like, pass, pass -- Korean is what's left
    const MATCH = DECK.length - 1;

    const cards = DECK.map(([slug, title, sub], i) => {
      const front = makeTex(420, 560, [`/images/cuisines/${slug}.jpg`], (g, w, h, [img]) => {
        g.clearRect(0, 0, w, h);
        g.save();
        rr(g, 2, 2, w - 4, h - 4, 30);
        g.clip();
        g.fillStyle = "#3A111B";
        g.fillRect(0, 0, w, h);
        if (img) cover(g, img, 0, 0, w, h);
        const sc = g.createLinearGradient(0, h * 0.45, 0, h);
        sc.addColorStop(0, "rgba(0,0,0,0)");
        sc.addColorStop(1, "rgba(0,0,0,.82)");
        g.fillStyle = sc;
        g.fillRect(0, 0, w, h);
        g.fillStyle = "#FFFFFF";
        g.font = `700 50px ${FONT}`;
        g.fillText(title, 24, h - 54);
        g.font = `500 22px ${FONT}`;
        g.fillStyle = "rgba(255,255,255,.82)";
        g.fillText(sub, 26, h - 22);
        if (i === MATCH) badge(g, 18, 18, "3 of 3 said yes", "#E8FF3A", "#1A0509");
        glassFinish(g, w, h);
        g.restore();
      });
      const frontMat = new THREE.MeshBasicMaterial({ map: front, transparent: true });
      const card = new THREE.Group();
      card.add(new THREE.Mesh(new THREE.PlaneGeometry(W, H), frontMat));
      card.userData.mat = frontMat;
      rig.add(card);
      return card;
    });

    // Back of the matched card: the order, revealed by the flip.
    const DISHES = [["bibimbap", "Bibimbap", true], ["kimbap", "Kimbap", true], ["korean-fried-chicken", "Fried chicken", false], ["japchae", "Japchae", false]] as const;
    const back = makeTex(420, 560, DISHES.map(([s]) => `/images/dishes/korean/${s}.jpg`), (g, w, h, imgs) => {
      g.clearRect(0, 0, w, h);
      g.save();
      rr(g, 2, 2, w - 4, h - 4, 30);
      g.clip();
      g.fillStyle = "#2B0A12";
      g.fillRect(0, 0, w, h);
      g.fillStyle = "#BC8A80";
      g.font = `600 20px ${FONT}`;
      g.fillText("Seoul Street Kitchen", 24, 44);
      g.fillStyle = "#FFF1EA";
      g.font = `700 38px ${FONT}`;
      g.fillText("Your order", 24, 86);
      const gap = 12, cw = (w - 48 - gap) / 2, ch = (h - 116 - 24 - gap) / 2;
      DISHES.forEach(([, name, locked], k) => {
        const x = 24 + (k % 2) * (cw + gap), y = 108 + Math.floor(k / 2) * (ch + gap);
        g.save();
        rr(g, x, y, cw, ch, 18);
        g.clip();
        g.fillStyle = "#3A111B";
        g.fillRect(x, y, cw, ch);
        if (imgs[k]) cover(g, imgs[k]!, x, y, cw, ch);
        const sc = g.createLinearGradient(0, y + ch * 0.5, 0, y + ch);
        sc.addColorStop(0, "rgba(0,0,0,0)");
        sc.addColorStop(1, "rgba(0,0,0,.8)");
        g.fillStyle = sc;
        g.fillRect(x, y, cw, ch);
        g.fillStyle = "#FFFFFF";
        g.font = `600 20px ${FONT}`;
        g.fillText(name, x + 12, y + ch - 14);
        g.restore();
        badge(g, x + 10, y + 10, locked ? "Locked · 3/3" : "2/3", locked ? "#E8FF3A" : "rgba(26,5,9,.8)", locked ? "#1A0509" : "#FFFFFF", 15);
        if (locked) {
          g.strokeStyle = "#E8FF3A";
          g.lineWidth = 4;
          rr(g, x + 2, y + 2, cw - 4, ch - 4, 16);
          g.stroke();
        }
      });
      glassFinish(g, w, h);
      g.restore();
    });
    const backMesh = new THREE.Mesh(new THREE.PlaneGeometry(W, H), new THREE.MeshBasicMaterial({ map: back, transparent: true }));
    backMesh.rotation.y = Math.PI;
    cards[MATCH].add(backMesh);

    // ---------- table code + people (chapter 1) ----------
    const code = makeTex(640, 220, [], (g, w, h) => {
      g.clearRect(0, 0, w, h);
      g.fillStyle = "#2B0A12";
      rr(g, 3, 3, w - 6, h - 6, 40);
      g.fill();
      g.strokeStyle = "#5E2532";
      g.lineWidth = 3;
      g.stroke();
      g.textAlign = "center";
      g.fillStyle = "#BC8A80";
      g.font = `600 26px ${FONT}`;
      g.fillText("Your table", w / 2, 58);
      g.fillStyle = "#FFF1EA";
      g.font = `700 112px ${FONT}`;
      if ("letterSpacing" in g) (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = "16px";
      g.fillText("K7QF", w / 2 + 8, 178);
    });
    const codeMat = new THREE.MeshBasicMaterial({ map: code, transparent: true, opacity: 0 });
    const codePlane = new THREE.Mesh(new THREE.PlaneGeometry(1.9, 0.65), codeMat);
    rig.add(codePlane);
    const people = ([["Y", "#FFF1EA", "#1A0509"], ["R", "#4A1B26", "#FFF1EA"], ["D", "#4A1B26", "#FFF1EA"]] as const).map(([l, fill, ink]) => {
      const t = makeTex(128, 128, [], (g, w, h) => {
        g.clearRect(0, 0, w, h);
        g.beginPath();
        g.arc(w / 2, h / 2, w / 2 - 3, 0, Math.PI * 2);
        g.fillStyle = fill;
        g.fill();
        g.fillStyle = ink;
        g.font = `700 58px ${FONT}`;
        g.textAlign = "center";
        g.textBaseline = "middle";
        g.fillText(l, w / 2, h / 2 + 3);
      });
      const mat = new THREE.MeshBasicMaterial({ map: t, transparent: true, opacity: 0 });
      const m = new THREE.Mesh(new THREE.PlaneGeometry(0.42, 0.42), mat);
      rig.add(m);
      return { m, mat };
    });

    // ---------- match heart + burst (chapter 3) ----------
    const hs = new THREE.Shape();
    hs.moveTo(0, 0.25);
    hs.bezierCurveTo(0, 0.25, -0.05, 0.5, -0.3, 0.5);
    hs.bezierCurveTo(-0.65, 0.5, -0.65, 0.12, -0.65, 0.12);
    hs.bezierCurveTo(-0.65, -0.1, -0.4, -0.35, 0, -0.6);
    hs.bezierCurveTo(0.4, -0.35, 0.65, -0.1, 0.65, 0.12);
    hs.bezierCurveTo(0.65, 0.12, 0.65, 0.5, 0.3, 0.5);
    hs.bezierCurveTo(0.05, 0.5, 0, 0.25, 0, 0.25);
    const heart = new THREE.Mesh(
      new THREE.ExtrudeGeometry(hs, { depth: 0.18, bevelEnabled: true, bevelThickness: 0.05, bevelSize: 0.04, bevelSegments: 4, curveSegments: 24 }),
      new THREE.MeshStandardMaterial({ color: 0xff4b2b, emissive: 0x5a1206, roughness: 0.4 }),
    );
    heart.geometry.center();
    heart.position.set(0.85, 1.2, 0.7);
    rig.add(heart);
    rim.position.set(0.9, 1.4, 1.6);
    rig.add(rim);
    const confN = 60;
    const conf = new THREE.InstancedMesh(
      new THREE.PlaneGeometry(0.035, 0.08),
      new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide, transparent: true, opacity: 0.9 }),
      confN,
    );
    const confDir: THREE.Vector3[] = [];
    for (let i = 0; i < confN; i++) {
      const th = Math.random() * Math.PI * 2;
      const ph = Math.acos(2 * Math.random() - 1);
      const r = 0.6 + Math.random() * 0.6;
      confDir.push(new THREE.Vector3(Math.sin(ph) * Math.cos(th) * r, Math.cos(ph) * r, Math.sin(ph) * Math.sin(th) * r * 0.5));
      conf.setColorAt(i, new THREE.Color(i % 4 === 0 ? 0xe8ff3a : i % 3 === 0 ? 0xff4b2b : 0xfff1ea));
    }
    conf.position.copy(heart.position);
    rig.add(conf);
    const confObj = new THREE.Object3D();

    // ---------- framing ----------
    let mobile = false;
    function resize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      mobile = w < 1024 || h > w;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.fov = mobile ? 50 : 40;
      camera.updateProjectionMatrix();
      // desktop: object right of the copy column; phone/tablet: above the bottom copy
      rig.position.set(mobile ? 0 : 2.1, mobile ? 1.05 : 0, 0);
      rig.scale.setScalar(mobile ? 0.82 : 1.15);
    }
    window.addEventListener("resize", resize);
    resize();

    const pointer = { x: 0, y: 0, sx: 0, sy: 0 };
    if (!coarse && !reduce) {
      window.addEventListener("pointermove", (e) => {
        pointer.x = e.clientX / window.innerWidth - 0.5;
        pointer.y = e.clientY / window.innerHeight - 0.5;
      }, { passive: true });
    }

    // Per-card poses. A pose is [x, y, z, rotZ].
    // Back cards peek out on the right only, so their labels (bottom-left) and
    // the match badge (top-left) stay hidden under the top card.
    const STACK = DECK.map((_, i) => [i * 0.035, i * 0.012, -i * 0.1, -0.012 * i]);
    const FAN = DECK.map((_, i) => {
      const a = (i - 2) * 0.2, R = 2.8;
      return [Math.sin(a) * R, Math.cos(a) * R - R + 0.45, -Math.abs(i - 2) * 0.08 - i * 0.01, -a];
    });
    const pose = [0, 0, 0, 0];
    // stack -> fan over chapter 0..1, fan -> stack over 1..2, stack after.
    function basePose(i: number, p: number) {
      const [a, b, t] = p <= 1 ? [STACK[i], FAN[i], p] : [FAN[i], STACK[i], p - 1];
      for (let k = 0; k < 4; k++) pose[k] = lerp(a[k], b[k], smooth(clamp(t)));
      return pose;
    }

    const clock = new THREE.Clock();
    let elapsed = 0;
    const bob = reduce ? 0 : 1;

    function frame() {
      requestAnimationFrame(frame);
      if (!worldVisible || document.hidden) { clock.getDelta(); return; }
      const dt = Math.min(clock.getDelta(), 1 / 30);
      elapsed += dt;
      smoothP = reduce ? Math.round(target) : smoothP + (target - smoothP) * (1 - Math.exp(-6 * dt));
      const p = smoothP;

      pointer.sx += (pointer.x - pointer.sx) * 0.05;
      pointer.sy += (pointer.y - pointer.sy) * 0.05;
      rig.rotation.y = Math.sin(elapsed * 0.4) * 0.1 * bob + pointer.sx * 0.35;
      rig.rotation.x = pointer.sy * 0.2;

      const matchT = smooth(clamp((p - 2.25) / 0.6));
      const flipT = smooth(clamp((p - 3.3) / 0.55));
      // Cards behind the current top card are dimmed (except while fanned out)
      // so any edge peeking past the top card reads as shadow, not a label.
      const swiped = (i: number) => clamp((p - 1.55 - i * 0.2) / 0.28);
      let top = 0;
      while (top < MATCH && swiped(top) >= 1) top++;
      const fanned = bell(p, 1, 0.8);
      cards.forEach((card, i) => {
        card.userData.mat.color.setScalar(i > top ? lerp(0.45, 1, fanned) : 1);
        const [x, y, z, rz] = basePose(i, p);
        card.position.set(x, y + Math.sin(elapsed * 1.1 + i) * 0.015 * bob, z);
        card.rotation.set(0, 0, rz);
        card.scale.setScalar(1);
        let opacity = 1;
        if (i < MATCH) {
          // swiped off one after another while the hand closes back into a stack
          const s = swiped(i);
          const e = s * s;
          card.position.x += SWIPE_DIR[i] * 4.2 * e;
          card.rotation.z += -SWIPE_DIR[i] * 0.55 * s;
          opacity = 1 - smooth(clamp((s - 0.5) / 0.5)); // stay opaque until it's clear of the deck
        } else {
          card.position.z += matchT * 0.6;
          card.rotation.z = lerp(rz, 0, matchT);
          card.scale.setScalar(1 + matchT * 0.18 + flipT * 0.06);
          card.rotation.y = Math.PI * flipT;
        }
        card.userData.mat.opacity = opacity;
        card.visible = opacity > 0.01;
      });

      // chapter 1 extras: table code under the hand, people orbiting it
      const tableT = bell(p, 1, 0.7);
      codeMat.opacity = tableT;
      codePlane.position.set(0, -1.55 + (1 - tableT) * -0.2, 0.3);
      people.forEach(({ m, mat }, k) => {
        const a = elapsed * 0.5 * bob + k * 2.09;
        m.position.set(Math.cos(a) * 1.4, -1.55 + Math.sin(a) * 0.55, 0.55 + Math.sin(a) * 0.2);
        mat.opacity = tableT;
      });

      // chapter 3: heart pops, small burst
      const m = bell(p, 3, 0.75);
      heart.scale.setScalar(0.001 + m * 0.6 * (1 + Math.sin(elapsed * 4.5) * 0.04 * bob));
      heart.rotation.y = reduce ? 0.3 : Math.sin(elapsed * 0.9) * 0.5;
      rim.intensity = m * 10;
      glowMat.opacity = 0.28 + m * 0.4 + Math.sin(elapsed * 0.8) * 0.04 * bob;
      glow.scale.setScalar(1 + m * 0.25);
      const spread = 0.2 + m * 1.2;
      for (let k = 0; k < confN; k++) {
        confObj.position.copy(confDir[k]).multiplyScalar(spread);
        confObj.rotation.set(elapsed * 1.5 + k, elapsed * 0.8 + k * 0.3, 0);
        confObj.scale.setScalar(m > 0.03 ? 1 : 0.0001);
        confObj.updateMatrix();
        conf.setMatrixAt(k, confObj.matrix);
      }
      conf.instanceMatrix.needsUpdate = true;

      renderer.render(scene, camera);
    }
    frame();
  }
</script>
