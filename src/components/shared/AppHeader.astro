---
// Persistent in-app navigation. Design system v2 (design-language-v2.md #3):
// a floating ink pill fixed above the home indicator on mobile (<1024px),
// flattening into a 68px ink app bar on desktop. Used by rooms.astro,
// rooms/join.astro, swipe.astro, match/[cuisine].astro and
// match/[cuisine]/[restaurant].astro.
//
// NOT used on the landing page (src/pages/index.astro), which has its own
// signed-in/signed-out header -- that one is marketing chrome, this is the
// app's persistent destination nav.
//
// The NAV is an island (HeaderNav) because auth must resolve client-side --
// this header is used by both per-request and statically prerendered pages;
// see header-nav.tsx's header comment for the full reasoning.
import { HeaderNav } from "./header-nav";

interface Props {
  /** Room code from the page's ?room=CODE, when it has one. */
  roomCode?: string | null;
}

const { roomCode = null } = Astro.props;
const pathname = Astro.url.pathname;
---

<!--
  Desktop (lg: 1024px+) only: a full-width 68px sticky ink bar at the top.
  Mobile has no shape here at all -- HeaderNav (the island below) renders its
  OWN fixed-position floating pill + account strip, independent of this
  container's DOM position, so it can also own their expand/collapse timers
  (see header-nav.tsx: both auto-collapse to a small corner button 5s after
  appearing, expandable again on tap -- the fix for "too much chrome on
  first load" feedback).
-->
<nav aria-label="Primary" class="lg:sticky lg:top-0 lg:z-40 lg:flex lg:h-[var(--fs-appbar-h)] lg:w-full lg:items-center lg:justify-between lg:bg-[var(--fs-ink)] lg:px-10">
  <a href="/" class="hidden shrink-0 items-center gap-2 lg:flex" aria-label="Food Swipe home">
    <div class="rounded-[var(--fs-r-sm)] bg-[var(--fs-terracotta)] p-1.5 text-[var(--fs-on-ink)]">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
        <path d="M7 2v20" />
        <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
      </svg>
    </div>
    <span class="font-display text-lg font-extrabold uppercase tracking-[-.02em] text-[var(--fs-on-ink)]">Food Swipe</span>
  </a>

  <HeaderNav roomCode={roomCode} pathname={pathname} client:load />
</nav>
