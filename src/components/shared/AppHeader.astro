---
// Persistent in-app header.
//
// Added after real two-user testing found that every in-app page was a dead
// end: BaseLayout rendered a bare <slot />, so once someone was in /swipe or
// /match/... there was no logo, no way home, no way to leave the room, and no
// log out -- only /logout existed and it was linked exclusively from the
// landing page. Used by rooms.astro, rooms/join.astro, swipe.astro,
// match/[cuisine].astro and match/[cuisine]/[restaurant].astro.
//
// NOT used on the landing page (src/pages/index.astro), which has its own
// signed-in/signed-out nav.
//
// Mostly static markup on purpose: the logo mark is the same inline SVG as
// index.astro's (kept inline rather than importing shared/logo.tsx, which is
// a React component and would mean hydrating an island just to draw a link),
// and Rooms / Log out are plain <a>. Only the room-code chip and the
// "Leave room" action need client state, so only those are an island.
import { RoomControls } from "./room-controls";

interface Props {
  /** Room code from the page's ?room=CODE, when it has one. */
  roomCode?: string | null;
}

const { roomCode = null } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-black/5 bg-background/80 backdrop-blur-md">
  <div class="container mx-auto flex items-center justify-between gap-2 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="Food Swipe home">
      <div class="rounded-lg bg-primary/80 p-1.5 text-primary-foreground transition-colors group-hover:bg-primary">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
          <path d="M7 2v20" />
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
        </svg>
      </div>
      <span class="font-headline text-xl font-bold text-foreground">Food Swipe</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href="/rooms"
        class="inline-flex h-9 items-center justify-center rounded-md px-3 font-body text-sm font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        Rooms
      </a>
      <RoomControls roomCode={roomCode} client:load />
      <a
        href="/logout"
        class="inline-flex h-9 items-center justify-center rounded-md px-3 font-body text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        Log out
      </a>
    </nav>
  </div>
</header>
